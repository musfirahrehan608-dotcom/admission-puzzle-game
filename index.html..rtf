\
<script>\
    const gridDisplay = document.getElementById('grid');\
    const scoreDisplay = document.getElementById('score');\
    let board = Array(16).fill(0);\
    let score = 0;\
\
    const tileColors = \{\
        2: \{bg: '#14b8a6', color: '#fff'\},\
        4: \{bg: '#06b6d4', color: '#fff'\},\
        8: \{bg: '#0ea5e9', color: '#fff'\},\
        16: \{bg: '#2563eb', color: '#fff'\},\
        32: \{bg: '#4f46e5', color: '#fff'\},\
        64: \{bg: '#7c3aed', color: '#fff'\},\
        128: \{bg: '#d946ef', color: '#fff'\},\
        256: \{bg: '#f43f5e', color: '#fff'\}\
    \};\
\
    function initGame() \{\
        board = Array(16).fill(0);\
        score = 0;\
        scoreDisplay.innerText = score;\
        generateTile();\
        generateTile();\
        updateDisplay();\
    \}\
\
    function generateTile() \{\
        let empties = board.map((val, idx) => val === 0 ? idx : null).filter(val => val !== null);\
        if (empties.length > 0) \{\
            let randomIdx = empties[Math.floor(Math.random() * empties.length)];\
            board[randomIdx] = Math.random() > 0.1 ? 2 : 4;\
        \}\
    \}\
\
    function updateDisplay() \{\
        gridDisplay.innerHTML = '';\
        for (let i = 0; i < 16; i++) \{\
            const tile = document.createElement('div');\
            tile.classList.add('tile');\
            if (board[i] > 0) \{\
                tile.innerText = board[i];\
                const styles = tileColors[board[i]] || \{bg: '#b91c1c', color: '#fff'\};\
                tile.style.backgroundColor = styles.bg;\
                tile.style.color = styles.color;\
                tile.style.transform = "scale(1)";\
            \} else \{\
                tile.style.backgroundColor = 'rgba(148, 163, 184, 0.08)';\
            \}\
            gridDisplay.appendChild(tile);\
        \}\
    \}\
\
    // Core Linear Transform Collapsing Logic\
    function slide(rowOrColumn) \{\
        let filtered = rowOrColumn.filter(val => val !== 0);\
        for (let i = 0; i < filtered.length - 1; i++) \{\
            if (filtered[i] === filtered[i + 1]) \{\
                filtered[i] *= 2;\
                score += filtered[i];\
                scoreDisplay.innerText = score;\
                filtered.splice(i + 1, 1);\
            \}\
        \}\
        while (filtered.length < 4) \{\
            filtered.push(0);\
        \}\
        return filtered;\
    \}\
\
    function move(direction) \{\
        let changed = false;\
        let oldBoard = [...board];\
\
        for (let i = 0; i < 4; i++) \{\
            let line = [];\
            for (let j = 0; j < 4; j++) \{\
                let idx = (direction === 'left' || direction === 'right') ? (i * 4 + j) : (j * 4 + i);\
                line.push(board[idx]);\
            \}\
\
            if (direction === 'right' || direction === 'down') line.reverse();\
            let newLine = slide(line);\
            if (direction === 'right' || direction === 'down') newLine.reverse();\
\
            for (let j = 0; j < 4; j++) \{\
                let idx = (direction === 'left' || direction === 'right') ? (i * 4 + j) : (j * 4 + i);\
                board[idx] = newLine[j];\
            \}\
        \}\
\
        if (oldBoard.some((val, idx) => val !== board[idx])) \{\
            generateTile();\
            updateDisplay();\
            checkGameOver();\
        \}\
    \}\
\
    function checkGameOver() \{\
        if (!board.includes(0)) \{\
            // Evaluates matrix borders for matching adjacent cell vectors\
            for (let i = 0; i < 4; i++) \{\
                for (let j = 0; j < 4; j++) \{\
                    let current = board[i * 4 + j];\
                    if (j < 3 && current === board[i * 4 + (j + 1)]) return;\
                    if (i < 3 && current === board[(i + 1) * 4 + j]) return;\
                \}\
            \}\
            alert(`Game Over! Evaluation Matrix filled. Final Score: $\{score\}`);\
        \}\
    \}\
\
    // Keyboard bindings for computer presentation\
    window.addEventListener('keydown', (e) => \{\
        if (e.key === 'ArrowLeft') move('left');\
        if (e.key === 'ArrowRight') move('right');\
        if (e.key === 'ArrowUp') move('up');\
        if (e.key === 'ArrowDown') move('down');\
    \});\
\
    // Touch Support for mobile phone evaluation (iPhone 17 Pro Max)\
    let touchStartX = 0; let touchStartY = 0;\
    gridDisplay.addEventListener('touchstart', e => \{\
        touchStartX = e.changedTouches[0].screenX;\
        touchStartY = e.changedTouches[0].screenY;\
    \});\
\
    gridDisplay.addEventListener('touchend', e => \{\
        let diffX = e.changedTouches[0].screenX - touchStartX;\
        let diffY = e.changedTouches[0].screenY - touchStartY;\
        if (Math.abs(diffX) > Math.abs(diffY)) \{\
            if (Math.abs(diffX) > 30) move(diffX > 0 ? 'right' : 'left');\
        \} else \{\
            if (Math.abs(diffY) > 30) move(diffY > 0 ? 'down' : 'up');\
        \}\
    \});\
\
    initGame();\
</script>\
